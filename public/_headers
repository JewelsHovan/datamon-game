# Cache rules for Cloudflare Workers static assets (spec 013, R5). Vite copies this file to
# dist/; Cloudflare reads it and does not serve it. One Cache-Control rule per path: rules that
# match the same request join their values, so the patterns below must not overlap.

# Hashed build output: a changed file gets a new name, so it never needs revalidating.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Art keeps its file names across deploys: cache it for at most an hour, then revalidate,
# so a deploy shows up within the hour. Atlas and stage URLs carry their manifest's
# version (?v=), so a fresh manifest never pairs with an older cached atlas.
/fighters/*
  Cache-Control: public, max-age=3600, must-revalidate

/effects/*
  Cache-Control: public, max-age=3600, must-revalidate

/stages/*
  Cache-Control: public, max-age=3600, must-revalidate

/datamon/*
  Cache-Control: public, max-age=3600, must-revalidate
